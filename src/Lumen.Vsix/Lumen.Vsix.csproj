<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <Deterministic>true</Deterministic>
    <UseWPF>true</UseWPF>
    <VSSDKBuildToolsAutoSetup>true</VSSDKBuildToolsAutoSetup>
    <VsixDeployOnDebug>true</VsixDeployOnDebug>
    <GeneratePkgDefFile>true</GeneratePkgDefFile>
    <IncludeAssemblyInVSIXContainer>true</IncludeAssemblyInVSIXContainer>
    <IncludeDebugSymbolsInVSIXContainer>false</IncludeDebugSymbolsInVSIXContainer>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <IncludeCopyLocalReferencesInVSIXContainer>false</IncludeCopyLocalReferencesInVSIXContainer>
  </PropertyGroup>
  <ItemGroup>
    <ProjectCapability Include="CreateVsixContainer" />
    <Reference Include="System.Design" />
    <Reference Include="System.Net.Http" />
    <Reference Include="System.Security" />
    <PackageReference Include="Microsoft.VisualStudio.SDK" Version="17.14.40265" ExcludeAssets="runtime" />
    <PackageReference Include="Microsoft.VSSDK.BuildTools" Version="18.5.38461" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4314.35" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <ProjectReference Include="../Lumen.Core/Lumen.Core.csproj" IncludeOutputGroupsInVSIX="BuiltProjectOutputGroup;SatelliteDllsProjectOutputGroup" />
    <ProjectReference Include="../Lumen.Providers/Lumen.Providers.csproj" IncludeOutputGroupsInVSIX="BuiltProjectOutputGroup;SatelliteDllsProjectOutputGroup" />
    <ProjectReference Include="../Lumen.Tools/Lumen.Tools.csproj" IncludeOutputGroupsInVSIX="BuiltProjectOutputGroup;SatelliteDllsProjectOutputGroup" />
    <VSCTCompile Include="Menus.vsct">
      <ResourceName>Menus.ctmenu</ResourceName>
    </VSCTCompile>
    <SourceVsixManifest Include="extension.vsixmanifest" />
    <Content Include="wwwroot/**/*">
      <IncludeInVSIX>true</IncludeInVSIX>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="skills/**/*">
      <IncludeInVSIX>true</IncludeInVSIX>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
  <!-- VSSDK stamps source timestamps into the zip; normalize them so Release VSIX bytes are reproducible. -->
  <Target Name="NormalizeVsixTimestamps" AfterTargets="CreateVsixContainer" Condition="'$(Configuration)' == 'Release' and Exists('$(TargetVsixContainer)')">
    <Exec Command="powershell.exe -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)/../../scripts/normalize-vsix.ps1&quot; &quot;$([MSBuild]::NormalizePath('$(MSBuildProjectDirectory)', '$(TargetVsixContainer)'))&quot;" />
  </Target>
  <Target Name="IncludeRuntimeDependencies" BeforeTargets="GetVsixSourceItems" DependsOnTargets="ResolveReferences">
    <!-- VSSDK otherwise drops framework-named NuGet dependencies such as System.Text.Json. -->
    <ItemGroup>
      <VSIXSourceItem Include="@(ReferenceCopyLocalPaths)" Condition="'%(ReferenceCopyLocalPaths.Extension)' == '.dll'">
        <VSIXSubPath>%(ReferenceCopyLocalPaths.DestinationSubDirectory)</VSIXSubPath>
      </VSIXSourceItem>
    </ItemGroup>
  </Target>
</Project>
